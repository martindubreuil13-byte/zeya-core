# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-...

# Realtime API Configuration (optional - defaults shown below)
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=sage

# Valid voices: sage, juniper, ember, onyx, echo, fawn, breeze
# Default: sage

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for anonymous outbound calls from /experience.
# Must reference a real, pre-existing businesses.id dedicated to demo traffic.
ZEYA_EXPERIENCE_BUSINESS_ID=00000000-0000-4000-8000-000000000000

# Default-off founder-reviewed voice learning for the configured Experience Business.
ZEYA_VOICE_LEARNING_ENABLED=false

# Optional: Debug logging
NEXT_PUBLIC_REALTIME_DEBUG=false
